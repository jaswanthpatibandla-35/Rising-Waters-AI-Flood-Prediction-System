# Flask Application Settings
SECRET_KEY=ReplaceWithARandomLongSecureStringHere1234!@#
FLASK_DEBUG=False
PORT=5000
HOST=0.0.0.0

# Database Settings
# For SQLite (default): leave blank or set URL
DATABASE_URL=sqlite:///database/flood.db
# For PostgreSQL / cloud deployment:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# OpenWeather API Key (optional - required for autofill weather features)
# Sign up at https://openweathermap.org/api to get a key
OPENWEATHER_API_KEY=your_openweather_api_key_goes_here
